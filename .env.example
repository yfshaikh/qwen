# --- LLM (chat) via OpenRouter ---
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings via OpenAI (OpenRouter has no embeddings endpoint) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Database (local Docker pgvector) ---
DATABASE_URL=postgresql://engram:engram@localhost:5432/engram

# --- Role -> model map (confirm exact slugs against the live OpenRouter catalog) ---
ENGRAM_MODEL_TUTOR=qwen/qwen3-vl-235b-a22b-instruct
ENGRAM_MODEL_EXTRACTOR=qwen/qwen-turbo
ENGRAM_MODEL_REFLECTOR=qwen/qwen-max
ENGRAM_MODEL_EMBEDDER=text-embedding-3-small

# Unset ENGRAM_MODEL_JUDGE falls back to the REFLECTOR (see Settings.model_for),
# which put ~63% of one eval run's spend on the most expensive model by accident.
# ENGRAM_MODEL_STUDENT=qwen/qwen-turbo
# ENGRAM_MODEL_JUDGE=qwen/qwen-turbo

# --- Role -> sampling temperature (optional; unset = provider default) ---
# REQUIRED for the frozen benchmark to be a gate. A frozen transcript
# (eval/scenarios/em-frozen-v1.yaml) pins the input, which leaves SAMPLING as the
# only source of run-to-run variance — so without these, `run` still executes but
# produces a number nobody can reproduce, and the eval emits a warning saying so.
#
# Only the Keeper's two roles need pinning; the tutor is deliberately left at the
# provider default so production behaviour is unchanged.
# ENGRAM_TEMPERATURE_EXTRACTOR=0
# ENGRAM_TEMPERATURE_REFLECTOR=0
# ENGRAM_TEMPERATURE_TUTOR=
# ENGRAM_TEMPERATURE_STUDENT=
# ENGRAM_TEMPERATURE_JUDGE=

# --- Embedding dimensions (must match migrations/0001_engram_schema.sql vector(N)) ---
ENGRAM_EMBEDDING_DIM=1024
