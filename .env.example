# --- LLM provider: OpenRouter (OpenAI-compatible gateway) ---
# Get a key at https://openrouter.ai/keys . The app boots without one; live
# model calls (tutor replies, Keeper extraction) fail until a key is set.
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Role -> model map (the #1 cost lever). Any OpenRouter slug works; swap freely.
# Qwen alternatives, e.g.: qwen/qwen-2.5-vl-72b-instruct, qwen/qwen-2.5-72b-instruct.
ENGRAM_MODEL_TUTOR=openai/gpt-4o-mini
ENGRAM_MODEL_EXTRACTOR=openai/gpt-4o-mini
ENGRAM_MODEL_REFLECTOR=openai/gpt-4o
ENGRAM_MODEL_EMBEDDER=openai/text-embedding-3-small

# --- Embeddings ---
# local  = deterministic feature-hashing embedder, no key, runs offline (default)
# api    = call an OpenAI-compatible /embeddings endpoint (set the two vars below)
ENGRAM_EMBEDDER_KIND=local
ENGRAM_EMBEDDING_DIM=1024          # must match the migration's vector(N) columns
ENGRAM_EMBEDDINGS_BASE_URL=
ENGRAM_EMBEDDINGS_API_KEY=

# --- Storage ---
# postgres = asyncpg + pgvector (default, real app); memory = in-process (demos)
ENGRAM_STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://engram:engram@localhost:5432/engram

# --- Keeper cron sweep (optional background loop inside the app) ---
ENGRAM_SWEEP_ENABLED=false
ENGRAM_SWEEP_INTERVAL_SECONDS=300
ENGRAM_SWEEP_QUIET_SECONDS=120
